{
  "agent_files": ["AGENTS.md"],
  "common_text_file": "home/.config/ooodnakov/agents/common-text.md",
  "common_data_file": "home/.config/ooodnakov/agents/common-data.json",
  "agent_clis": [
    { "name": "OpenAI Codex CLI", "command": "codex" },
    { "name": "Claude Code", "command": "claude" },
    { "name": "Gemini CLI", "command": "gemini" },
    { "name": "Aider", "command": "aider" },
    { "name": "Qwen Code", "command": "qwen" },
    { "name": "Cursor Agent", "command": "cursor-agent" },
    { "name": "OpenCode", "command": "opencode" },
    { "name": "Pi Agent", "command": "pi" },
    { "name": "Oh My Pi", "command": "omp" },
    { "name": "Command Code", "command": "command-code" }
  ],
  "agent_updates": [
    { "name": "OpenAI Codex CLI", "command": "codex", "preferred": "npm", "package": "@openai/codex" },
    {
      "name": "Claude Code",
      "command": "claude",
      "preferred": "npm",
      "package": "@anthropic-ai/claude-code",
      "install_script": "node $(pnpm root -g)/@anthropic-ai/claude-code/install.cjs",
      "install_script_ps": "node \"$(pnpm root -g)/@anthropic-ai/claude-code/install.cjs\""
    },
    { "name": "Gemini CLI", "command": "gemini", "preferred": "npm", "package": "@google/gemini-cli" },
    { "name": "Qwen Code", "command": "qwen", "preferred": "npm", "package": "@qwen-code/qwen-code" },
    { "name": "Cursor Agent", "command": "cursor-agent", "preferred": "npm", "package": "cursor-agent" },
    { "name": "OpenCode", "command": "opencode", "preferred": "npm", "package": "opencode-ai" },
    { "name": "Aider", "command": "aider", "preferred": "uv", "package": "aider-chat" },
    { "name": "Pi Agent", "command": "pi", "preferred": "npm", "package": "@earendil-works/pi-coding-agent" },
    { "name": "Oh My Pi", "command": "omp", "preferred": "npm", "package": "@oh-my-pi/pi-coding-agent" },
    { "name": "Command Code", "command": "command-code", "preferred": "npm", "package": "@command-code/cli" }
  ],
  "agent_configs": [
    {
      "name": "OpenAI Codex CLI",
      "agents": ["codex"],
      "format": "toml",
      "default_paths": ["~/.codex/config.toml"],
      "docs_url": "https://github.com/openai/codex"
    },
    {
      "name": "Codex Global Instructions",
      "agents": ["codex"],
      "format": "markdown",
      "default_paths": ["~/.codex/AGENTS.md"]
    },
    {
      "name": "Claude Code",
      "agents": ["claude"],
      "format": "json",
      "default_paths": ["~/.claude/settings.json"],
      "docs_url": "https://docs.anthropic.com/en/docs/claude-code"
    },
    {
      "name": "Claude Global Instructions",
      "agents": ["claude"],
      "format": "markdown",
      "default_paths": ["~/.claude/CLAUDE.md"]
    },
    {
      "name": "Gemini CLI",
      "agents": ["gemini"],
      "format": "json",
      "default_paths": ["~/.gemini/settings.json"],
      "docs_url": "https://github.com/google-gemini/gemini-cli"
    },
    {
      "name": "Gemini Global Instructions",
      "agents": ["gemini"],
      "format": "markdown",
      "default_paths": ["~/.gemini/AGENTS.md"]
    },
    {
      "name": "Aider",
      "agents": ["aider"],
      "format": "yaml",
      "default_paths": ["~/.aider.conf.yml", "~/.config/aider/aider.conf.yml"],
      "docs_url": "https://aider.chat/docs/config/aider_conf.html"
    },
    {
      "name": "OpenCode",
      "agents": ["opencode"],
      "format": "json",
      "default_paths": ["~/.config/opencode/opencode.json"],
      "docs_url": "https://opencode.ai/docs"
    },
    {
      "name": "OpenCode Global Instructions",
      "agents": ["opencode"],
      "format": "markdown",
      "default_paths": ["~/.config/opencode/AGENTS.md"]
    },
    {
      "name": "Pi Agent",
      "agents": ["pi"],
      "format": "json",
      "default_paths": ["~/.pi/agent/settings.json"],
      "mcp_paths": ["~/.pi/mcp.json"],
      "docs_url": "https://www.npmjs.com/package/@earendil-works/pi-coding-agent"
    },
    {
      "name": "Pi Agent Global Instructions",
      "agents": ["pi"],
      "format": "markdown",
      "default_paths": ["~/.pi/agent/AGENTS.md"]
    },
    {
      "name": "Oh My Pi",
      "agents": ["omp"],
      "format": "yaml",
      "default_paths": ["~/.omp/agent/config.yml"],
      "mcp_paths": ["~/.omp/agent/mcp.json"],
      "docs_url": "https://www.npmjs.com/package/@oh-my-pi/pi-coding-agent"
    },
    {
      "name": "Oh My Pi Global Instructions",
      "agents": ["omp"],
      "format": "markdown",
      "default_paths": ["~/.omp/agent/AGENTS.md", "~/.omp/CLAUDE.md", "~/.omp/.claude/CLAUDE.md"]
    },
    {
      "name": "Command Code",
      "agents": ["command-code"],
      "format": "json",
      "default_paths": ["~/.commandcode/config.json"],
      "mcp_skip": true,
      "docs_url": "https://www.npmjs.com/package/@command-code/cli"
    },
    {
      "name": "Command Code Global Instructions",
      "agents": ["command-code"],
      "format": "markdown",
      "default_paths": ["~/.commandcode/AGENTS.md"]
    }
  ]
}
