#!/usr/bin/env python3
"""herdr-task: small task lists for the folder you are working in.

A task is a title, an optional note and a status (todo, doing, blocked, done)
in one JSON list per folder, so every agent and the `oo-tasks` panel see the
same list. Lists live in tasks/<slug>.json under the root recorded in
~/.config/ooodnakov/herdr-data (default ~/.local/share/ooodnakov/herdr).

    herdr-task add "Split the importer" --note "Then run the tests"
    herdr-task add "Run the tests" --after t-20260101-a1b2c3
    herdr-task list --ready
    herdr-task dep t-20260101-a1b2c3 t-20260101-d4e5f6
    herdr-task set t-20260101-a1b2c3 doing
    herdr-task show t-20260101-a1b2c3
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import shutil
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from _herdr_store import (  # noqa: E402
    TASK_STATUSES,
    Fail,
    data_root,
    edit_list,
    find,
    folder_for,
    new_id,
    normalize,
    now,
    read_list,
    slug_for,
)


def emit(args: argparse.Namespace, data: object, text: str) -> None:
    print(json.dumps(data, indent=2, ensure_ascii=False) if args.json else text)


def task_list(args: argparse.Namespace) -> None:
    folder = folder_for(args.folder)
    _, data = read_list("tasks", "tasks", folder)
    tasks = [task for task in data["tasks"] if not args.status or task.get("status") == args.status]
    if args.ready:
        tasks = [task for task in tasks if not waiting_on(task, data["tasks"])]
    tasks.sort(key=lambda task: task.get("created", ""))
    if args.json:
        print(json.dumps({"format": data.get("format"), "folder": folder, "tasks": tasks}, indent=2, ensure_ascii=False))
        return
    for task in tasks:
        open_deps = len(waiting_on(task, data["tasks"]))
        suffix = f"\tafter {open_deps}" if open_deps else ""
        print(f"{task['id']}\t{task.get('status', 'todo')}\t{task.get('title', '')}{suffix}")
    if not tasks:
        print("no tasks", file=sys.stderr)


def task_add(args: argparse.Namespace) -> None:
    folder = folder_for(args.folder)
    title = " ".join(args.title).strip()
    if not title:
        raise Fail("a task needs a title")
    if args.status not in TASK_STATUSES:
        raise Fail(f"status must be one of: {', '.join(TASK_STATUSES)}")
    stamp = now()
    task = {
        "id": new_id("t"),
        "title": title,
        "note": args.note or "",
        "status": args.status,
        "created": stamp,
        "updated": stamp,
    }
    with edit_list("tasks", "tasks", folder) as data:
        task["deps"] = resolve_deps(data["tasks"], args.after or [], task["id"])
        data["tasks"].append(task)
    emit(args, task, f"{task['id']}  {task['status']}  {task['title']}")


def task_set(args: argparse.Namespace) -> None:
    if args.status not in TASK_STATUSES:
        raise Fail(f"status must be one of: {', '.join(TASK_STATUSES)}")
    folder = folder_for(args.folder)
    with edit_list("tasks", "tasks", folder) as data:
        task = find(data["tasks"], args.id)
        previous = task.get("status", "todo")
        task["status"] = args.status
        task["updated"] = now()
    emit(args, task, f"{task['id']}  {previous} -> {task['status']}")


def terminal_name(text: str, fallback: str) -> str:
    """hc's names: 1-32 of a-z 0-9 - _ . starting with a letter or digit."""
    def shaped(value: str) -> str:
        name = re.sub(r"[^a-z0-9._-]+", "-", str(value).lower())
        name = re.sub(r"^[^a-z0-9]+", "", name)
        return name.rstrip("-._")[:32].rstrip("-._")

    return shaped(text) or shaped(fallback) or "task"


def waiting_on(task: dict, tasks: list[dict]) -> list[str]:
    """The task's dependencies that are not done yet: what keeps it from starting."""
    status = {item.get("id"): item.get("status", "todo") for item in tasks}
    return [dep for dep in task.get("deps") or [] if status.get(dep) != "done"]


def resolve_deps(tasks: list[dict], refs: list[str], own_id: str | None = None) -> list[str]:
    """Canonical ids for the `--after`/`dep` arguments, refusing unknown and self references."""
    resolved: list[str] = []
    for ref in refs:
        for part in str(ref).split(","):
            part = part.strip()
            if not part:
                continue
            dep = find(tasks, part)
            if own_id and dep["id"] == own_id:
                raise Fail("a task cannot depend on itself")
            if dep["id"] not in resolved:
                resolved.append(dep["id"])
    return resolved


def reaches(tasks: list[dict], start: str, target: str) -> bool:
    """Whether following `start`'s dependencies ever arrives at `target` (a cycle)."""
    deps = {item.get("id"): item.get("deps") or [] for item in tasks}
    stack, seen = [start], set()
    while stack:
        current = stack.pop()
        if current == target:
            return True
        if current in seen:
            continue
        seen.add(current)
        stack.extend(deps.get(current) or [])
    return False


def task_depend(args: argparse.Namespace) -> None:
    folder = folder_for(args.folder)
    with edit_list("tasks", "tasks", folder) as data:
        task = find(data["tasks"], args.id)
        blockers = resolve_deps(data["tasks"], args.ids, task["id"])
        for blocker in blockers:
            if reaches(data["tasks"], blocker, task["id"]):
                raise Fail(f"{blocker} already waits on {task['id']}; that would be a cycle")
        task["deps"] = list(dict.fromkeys((task.get("deps") or []) + blockers))
        task["updated"] = now()
    emit(args, task, f"{task['id']}  after {', '.join(task['deps'])}")


def task_undepend(args: argparse.Namespace) -> None:
    folder = folder_for(args.folder)
    with edit_list("tasks", "tasks", folder) as data:
        task = find(data["tasks"], args.id)
        drop = set(resolve_deps(data["tasks"], args.ids))
        task["deps"] = [dep for dep in (task.get("deps") or []) if dep not in drop]
        task["updated"] = now()
    emit(args, task, f"{task['id']}  after {', '.join(task['deps']) or 'nothing'}")


def task_show(args: argparse.Namespace) -> None:
    folder = folder_for(args.folder)
    _, data = read_list("tasks", "tasks", folder)
    task = find(data["tasks"], args.id)
    lines = [f"{task['id']}  {task.get('status', 'todo')}", task.get("title", "")]
    if task.get("terminal"):
        lines.append(f"agent {task['terminal']}")
    if task.get("deps"):
        by_id = {item.get("id"): item for item in data["tasks"]}
        lines.append("after")
        for dep in task["deps"]:
            item = by_id.get(dep) or {}
            lines.append(f"  {dep}  {item.get('status', 'gone')}  {item.get('title', '')}")
    if task.get("worktree"):
        tool = f", {task['worktree_tool']}" if task.get("worktree_tool") else ""
        lines.append(f"worktree {task['worktree']} ({task.get('branch', '')}{tool})")
    if task.get("note"):
        lines += ["", task["note"]]
    lines += ["", f"updated {task.get('updated', '')}"]
    emit(args, task, "\n".join(lines))


def task_rm(args: argparse.Namespace) -> None:
    folder = folder_for(args.folder)
    with edit_list("tasks", "tasks", folder) as data:
        task = find(data["tasks"], args.id)
        data["tasks"] = [item for item in data["tasks"] if item is not task]
        for item in data["tasks"]:
            if task["id"] in (item.get("deps") or []):
                item["deps"] = [dep for dep in item["deps"] if dep != task["id"]]
    emit(args, task, f"removed {task['id']}")


def task_path(args: argparse.Namespace) -> None:
    path, _ = read_list("tasks", "tasks", folder_for(args.folder))
    print(path)


def task_key(folder: str, task_id: str) -> str:
    """What a task's agent terminal carries, so the panel can find it again."""
    return f"{slug_for(data_root(), folder)}#{task_id}"


def task_label(args: argparse.Namespace) -> None:
    folder = folder_for(args.folder)
    _, data = read_list("tasks", "tasks", folder)
    task = find(data["tasks"], args.id)
    label = f"herdr.task={task_key(folder, task['id'])}"
    emit(args, {"label": label}, label)


def task_bind(args: argparse.Namespace) -> None:
    folder = folder_for(args.folder)
    with edit_list("tasks", "tasks", folder) as data:
        task = find(data["tasks"], args.id)
        task["terminal"] = args.terminal
        task["updated"] = now()
    emit(args, task, f"{task['id']}  {args.terminal or 'unbound'}")


def git(repo: str, *argv: str) -> subprocess.CompletedProcess:
    if not shutil.which("git"):
        raise Fail("git is not on PATH")
    return subprocess.run(["git", "-C", repo, *argv], capture_output=True, text=True)


def repo_root(folder: str) -> str:
    result = git(folder, "rev-parse", "--show-toplevel")
    if result.returncode != 0:
        raise Fail(f"{folder} is not inside a git worktree")
    return normalize(result.stdout.strip())


def registered_worktrees(repo: str) -> dict[str, str | None]:
    """Every worktree git knows for `repo`, keyed by normalized path."""
    result = git(repo, "worktree", "list", "--porcelain")
    if result.returncode != 0:
        raise Fail(result.stderr.strip() or "git worktree list failed")
    found: dict[str, str | None] = {}
    path = branch = None
    for line in result.stdout.splitlines() + [""]:
        if line.startswith("worktree "):
            path, branch = normalize(line[len("worktree ") :]), None
        elif line.startswith("branch "):
            branch = line[len("branch ") :].removeprefix("refs/heads/")
        elif not line and path:
            found[path] = branch
            path = None
    return found


def worktrunk() -> str | None:
    """Worktrunk's executable, when installed. On Windows it is `git-wt` (`wt` is Windows Terminal)."""
    for name in ("git-wt", "worktrunk"):
        found = shutil.which(name)
        if found:
            return found
    if os.name == "nt":
        return None
    found = shutil.which("wt")
    if not found:
        return None
    try:
        result = subprocess.run([found, "--version"], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    return found if "worktrunk" in f"{result.stdout}{result.stderr}".lower() else None


def worktree_plan(
    folder: str, task_id: str, path_arg: str | None
) -> tuple[str, str, list[list[str]], str]:
    """The worktree's path, its branch, the commands still needed, and the tool that makes it."""
    repo = repo_root(folder)
    branch = f"herdr/{task_id}"
    path = normalize(path_arg) if path_arg else normalize(
        os.path.join(os.path.dirname(repo), f"{os.path.basename(repo)}-wt", task_id)
    )
    existing = registered_worktrees(repo)
    if path in existing:
        return path, existing[path] or branch, [], "existing"
    exists = git(repo, "show-ref", "--verify", "--quiet", f"refs/heads/{branch}").returncode == 0
    wt = worktrunk()
    if wt:
        command = [wt, "-C", repo, "switch", "--no-cd", "--path", path]
        command += [branch] if exists else ["--create", branch]
        return path, branch, [command], "worktrunk"
    if exists:
        return path, branch, [["git", "-C", repo, "worktree", "add", path, branch]], "git"
    return path, branch, [["git", "-C", repo, "worktree", "add", "-b", branch, path]], "git"


def spawn_argv(args: argparse.Namespace, argv: list[str]) -> list[str]:
    if not args.keep_open:
        return argv
    script = f"{shlex.join(argv)}; exec \"${{SHELL:-sh}}\""
    return ["sh", "-c", script]


def task_spawn(args: argparse.Namespace) -> None:
    folder = folder_for(args.folder)
    _, data = read_list("tasks", "tasks", folder)
    task = find(data["tasks"], args.id)
    open_deps = waiting_on(task, data["tasks"])
    if open_deps and not args.force:
        raise Fail(f"{task['id']} waits on {', '.join(open_deps)}; finish them first, or pass --force")
    argv = list(args.argv)
    while argv and argv[0] == "--":
        argv.pop(0)
    if not argv:
        raise Fail("spawn needs a program: herdr-task spawn <id> -- <program> [args…]")
    argv = spawn_argv(args, argv)

    worktree = branch = tool = None
    git_commands: list[list[str]] = []
    if args.worktree is not None:
        worktree, branch, git_commands, tool = worktree_plan(folder, task["id"], args.worktree or None)

    command = [
        "hc", "run", "--keep", "--bg", "--json",
        "--label", f"herdr.task={task_key(folder, task['id'])}",
        "--cwd", args.cwd or worktree or folder,
    ]
    if args.name:
        command += ["--name", terminal_name(args.name, task["id"])]
    command += ["--", *argv]
    if args.dry_run:
        for git_command in git_commands:
            print(shlex.join(git_command))
        print(shlex.join(command))
        return
    for git_command in git_commands:
        result = subprocess.run(git_command, capture_output=True, text=True)
        if result.returncode != 0:
            raise Fail(result.stderr.strip() or f"{git_command[0]} failed ({result.returncode})")
    if not shutil.which("hc"):
        raise Fail("hc (herdr-core) is not on PATH")
    if args.keep_open and not shutil.which("sh"):
        raise Fail("--keep-open needs sh on PATH")
    result = subprocess.run(command, capture_output=True, text=True)
    if result.returncode != 0:
        raise Fail(result.stderr.strip() or f"hc run failed ({result.returncode})")
    try:
        started = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise Fail(f"hc run printed no JSON: {result.stdout.strip()}") from error
    address = started.get("address")
    if not address:
        raise Fail("hc run printed no terminal address")
    with edit_list("tasks", "tasks", folder) as data:
        task = find(data["tasks"], args.id)
        task["terminal"] = address
        if worktree:
            task["worktree"] = worktree
            task["branch"] = branch
            if tool and tool != "existing":
                task["worktree_tool"] = tool
        if task.get("status", "todo") == "todo":
            task["status"] = "doing"
        task["updated"] = now()
    emit(args, task, f"{task['id']}  {address}  {task['title']}")


def task_kill(args: argparse.Namespace) -> None:
    folder = folder_for(args.folder)
    _, data = read_list("tasks", "tasks", folder)
    task = find(data["tasks"], args.id)
    address = task.get("terminal")
    if not address:
        raise Fail(f"{task['id']} has no terminal to stop")
    if shutil.which("hc"):
        subprocess.run(["hc", "kill", address], capture_output=True, text=True)
    with edit_list("tasks", "tasks", folder) as data:
        task = find(data["tasks"], args.id)
        task["terminal"] = None
        task["updated"] = now()
    emit(args, task, f"stopped {address}")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="herdr-task", description="Task lists per folder for Herdr and its agents.")
    # Also accepted after the command (`herdr-task list --folder …`); SUPPRESS keeps
    # the top-level value when the flag comes before it.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--folder", default=argparse.SUPPRESS, help="the folder's list (default: this git worktree, else this folder)")
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS, help="print JSON")
    parser.add_argument("--folder", help="the folder's list (default: this git worktree, else this folder)")
    parser.add_argument("--json", action="store_true", help="print JSON")
    commands = parser.add_subparsers(dest="command", required=True)

    listing = commands.add_parser("list", parents=[common], help="list tasks")
    listing.add_argument("--status", choices=TASK_STATUSES, help="only this status")
    listing.add_argument("--ready", action="store_true", help="only tasks whose dependencies are all done")
    listing.set_defaults(handler=task_list)

    add = commands.add_parser("add", parents=[common], help="add a task")
    add.add_argument("title", nargs="+", help="what needs doing")
    add.add_argument("-n", "--note", help="details for whoever picks it up")
    add.add_argument("-s", "--status", default="todo", choices=TASK_STATUSES)
    add.add_argument("-a", "--after", action="append", metavar="ID", help="a task that must be done first (repeatable)")
    add.set_defaults(handler=task_add)

    change = commands.add_parser("set", parents=[common], help="change a task's status")
    change.add_argument("id")
    change.add_argument("status", choices=TASK_STATUSES)
    change.set_defaults(handler=task_set)

    show = commands.add_parser("show", parents=[common], help="show a task")
    show.add_argument("id")
    show.set_defaults(handler=task_show)

    remove = commands.add_parser("rm", parents=[common], help="remove a task")
    remove.add_argument("id")
    remove.set_defaults(handler=task_rm)

    depend = commands.add_parser("dep", parents=[common], help="make a task wait for other tasks")
    depend.add_argument("id")
    depend.add_argument("ids", nargs="+", help="tasks that must be done first")
    depend.set_defaults(handler=task_depend)

    undepend = commands.add_parser("undep", parents=[common], help="drop a task's dependency on other tasks")
    undepend.add_argument("id")
    undepend.add_argument("ids", nargs="+")
    undepend.set_defaults(handler=task_undepend)

    label = commands.add_parser("label", parents=[common], help="print the herdr.task label a terminal carries for this task")
    label.add_argument("id")
    label.set_defaults(handler=task_label)

    bind = commands.add_parser("bind", parents=[common], help="attach a task to a terminal started elsewhere (omit the address to detach)")
    bind.add_argument("id")
    bind.add_argument("terminal", nargs="?")
    bind.set_defaults(handler=task_bind)

    spawn = commands.add_parser(
        "spawn",
        parents=[common],
        help="start an agent for a task in a herdr terminal (hc run --keep --bg), labelled so the panel finds it",
    )
    spawn.add_argument("id")
    spawn.add_argument("--cwd", help="where the agent starts (default: the task's worktree, else the task's folder)")
    spawn.add_argument("--name", help="the terminal's name (default: hc's)")
    spawn.add_argument(
        "--keep-open",
        action="store_true",
        help="run through sh -c so the terminal survives the program exiting (needs sh)",
    )
    spawn.add_argument(
        "--worktree",
        nargs="?",
        const="",
        metavar="PATH",
        help="make a worktree for the task and spawn there: worktrunk (`git-wt` on Windows, `wt` elsewhere) when installed, else git worktree add -b herdr/<id> (default path: <repo>-wt/<id> beside the repo)",
    )
    spawn.add_argument("--dry-run", action="store_true", help="print the git and hc commands instead of running them")
    spawn.add_argument("--force", action="store_true", help="start even while dependencies are not done")
    spawn.add_argument("argv", nargs="*", help="-- <program> [args…]")
    spawn.set_defaults(handler=task_spawn)

    kill = commands.add_parser("kill", parents=[common], help="end the task's agent terminal")
    kill.add_argument("id")
    kill.set_defaults(handler=task_kill)

    where = commands.add_parser("path", parents=[common], help="print the folder's list path")
    where.set_defaults(handler=task_path)
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        args.handler(args)
    except Fail as error:
        print(f"herdr-task: {error}", file=sys.stderr)
        return 1
    except BrokenPipeError:
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
